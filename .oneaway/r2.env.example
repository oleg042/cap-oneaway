# Cloudflare R2 storage profile
#
# Copy the values into .env to move storage off local MinIO. No code changes:
# Cap's storage layer is S3-generic and R2 is an S3 implementation.
#
# Read .oneaway/RUNBOOK.md "Promoting storage to R2" before using this —
# swapping these on an instance that already has recordings breaks every
# existing share link unless the objects are copied first.

# --- Credentials ---
# Cloudflare dashboard → R2 → Manage API Tokens → Create API Token.
# Scope it to Object Read & Write on the one bucket, not account-wide.
CAP_AWS_ACCESS_KEY=<r2-access-key-id>
CAP_AWS_SECRET_KEY=<r2-secret-access-key>
CAP_AWS_BUCKET=cap

# R2 ignores region but the S3 SDK requires one. "auto" is R2's documented value.
CAP_AWS_REGION=auto

# --- Endpoints ---
# Both point at R2. Unlike the MinIO setup there is no separate internal
# address: the "internal" client signs server-side fetches, the "public" one
# signs the URLs a viewer's browser follows, and for R2 both are the same host.
#
# ACCOUNT_ID is on the Cloudflare R2 overview page.
S3_INTERNAL_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# R2's S3 API is path-style.
S3_PATH_STYLE=true

# --- Public URL of the instance itself (not storage) ---
# Must be the address teammates and clients actually use. Cap reads WEB_URL at
# runtime, so this can change without a rebuild.
CAP_URL=https://video.oneaway.io

# --- Optional: custom domain for media ---
# Binding a domain to the bucket (R2 → Settings → Custom Domains) lets media
# serve from video-cdn.oneaway.io instead of a raw r2.cloudflarestorage.com
# host. Set S3_PUBLIC_ENDPOINT to it if used — viewer-facing presigned URLs are
# signed against this host, so changing it later invalidates URLs already
# signed, though not the share-page links themselves.
# S3_PUBLIC_ENDPOINT=https://video-cdn.oneaway.io

# --- Why R2 ---
# $0.015/GB/month with zero egress fees. Egress is the whole argument: video is
# read-heavy, and S3 or GCS would bill every client view.
